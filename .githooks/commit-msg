#!/bin/sh
# commit-msg: keep the claude.ai session line out of every commit (Phase 16, D-13).
# Deletes lines that start (any case, optional indent) with the session trailer and lines that hold a claude.ai session URL;
# every other line, the Co-Authored-By trailer included, stays. Enable once per clone with:
#   git config core.hooksPath .githooks
msg="$1"
[ -f "$msg" ] || exit 0
# grep exits 1 when no line is left (an empty message), which is fine; 2 or more is a real error
# case-insensitive and indented lines too, so the hook is never weaker than the scan's session rules
grep -v -i -E -e '^[[:space:]]*Claude-Session:' -e 'claude\.ai/code/session' "$msg" > "$msg.tmp"
status=$?
if [ "$status" -gt 1 ]; then
  rm -f "$msg.tmp"
  exit "$status"
fi
mv -f "$msg.tmp" "$msg"
